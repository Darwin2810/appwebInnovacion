rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(companyId) {
      return /databases/$(database)/documents/organizations/$(companyId)/members/$(request.auth.uid);
    }
    function isMember(companyId) {
      return signedIn() && exists(memberPath(companyId))
        && get(memberPath(companyId)).data.active == true
        && get(memberPath(companyId)).data.role in ['admin', 'operator', 'viewer'];
    }
    function isAdmin(companyId) {
      return isMember(companyId) && get(memberPath(companyId)).data.role == 'admin';
    }
    function isStaff(companyId) {
      return isMember(companyId) && get(memberPath(companyId)).data.role in ['admin', 'operator'];
    }
    function canReadCatalog(companyId) {
      return isStaff(companyId)
        || (isMember(companyId) && resource.data.kind == 'finished');
    }

    match /organizations/{companyId} {
      allow get: if isMember(companyId);
      allow list, write: if false;

      match /members/{uid} {
        // Pending users may read their own approval status; only an admin sees the team.
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin(companyId));
        allow list: if isAdmin(companyId);
        allow write: if false;
      }
      match /references/{referenceId} {
        // Viewer collection queries must contain where('kind', '==', 'finished').
        allow read: if canReadCatalog(companyId);
        allow write: if false;
      }
      match /variants/{variantId} {
        allow read: if canReadCatalog(companyId);
        allow write: if false;
      }
      match /products/{legacyId} {
        // The previous catalogue remains visible until an admin migrates it.
        allow read: if isMember(companyId);
        allow write: if false;
      }
      match /movements/{movementId} {
        allow read: if isStaff(companyId);
        allow write: if false;
      }
      match /{privateCollection}/{documentId} {
        allow read: if privateCollection in [
          'costs', 'journals', 'commands', 'audit', 'sales', 'purchases',
          'payments', 'productionBoms', 'productionOrders', 'employees',
          'attendance', 'payroll', 'financeEntries', 'contacts', 'migrations'
        ] && isAdmin(companyId);
        // All business mutations go through the authenticated ERP callable.
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
