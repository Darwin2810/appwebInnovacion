{
  "name": "exlaider-inventario",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator",
    "emulators": "node scripts/firebase.mjs emulators:start --project demo-inventario --only auth,firestore",
    "firebase": "node scripts/firebase.mjs",
    "test": "node --test tests/productModel.test.mjs tests/qr.test.mjs",
    "test:cloud": "node scripts/firebase.mjs emulators:exec --project demo-inventario --only auth,firestore \"node --test tests/firestore.integration.test.mjs\"",
    "test:browser": "node scripts/firebase.mjs emulators:exec --project demo-inventario --only auth,firestore \"node scripts/ci-browser.mjs\"",
    "deploy": "npm run build && node scripts/firebase.mjs deploy --only firestore,hosting"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "html5-qrcode": "2.3.8",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "15.33.0",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
